@* Wordle Crkr *@

<div class="container">
    <div class="letter-container" style="--n: 0; --d: 0s; --r: -1;">
        <div class="upper"><span class="letter">A</span></div>
        <div class="middle"><span class="letter">B</span></div>
        <div class="lower active"><span class="letter">C</span></div>
    </div>
    <div class="letter-container" style="--n: 0; --d: 1s; --r: 1;">
        <div class="upper active"><span class="letter">A</span></div>
        <div class="middle"><span class="letter">B</span></div>
        <div class="lower"><span class="letter">C</span></div>
    </div>
    <div class="letter-container" style="--n: 0; --d: 0.6s; --r: -1;">
        <div class="upper"><span class="letter">A</span></div>
        <div class="middle"><span class="letter">B</span></div>
        <div class="lower active"><span class="letter">C</span></div>
    </div>
    <div class="letter-container" style="--n: 0; --d: 1.4s; --r: -1;">
        <div class="upper"><span class="letter">A</span></div>
        <div class="middle"><span class="letter">B</span></div>
        <div class="lower active"><span class="letter">C</span></div>
    </div>
    <div class="letter-container" style="--n: 0; --d: 0.2s; --r: -1;">
        <div class="upper"><span class="letter">A</span></div>
        <div class="middle"><span class="letter">B</span></div>
        <div class="lower active"><span class="letter">C</span></div>
    </div>
    <div class="letter-container" style="--n: 0; --d: 0.8s; --r: -1;">
        <div class="upper"><span class="letter">A</span></div>
        <div class="middle"><span class="letter">B</span></div>
        <div class="lower active"><span class="letter">C</span></div>
    </div>
</div>