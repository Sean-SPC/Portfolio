@* Wordle Crkr *@

@{
    var containers = new[]
    {
        new { Target = "W", Cap = 1, Count = 0, Delay = "0s", Direction = -1, Toggle = false},
        new { Target = "O", Cap = 2, Count = 0, Delay = "1s", Direction = 1, Toggle = true},
        new { Target = "R", Cap = 3, Count = 0, Delay = "0.6s", Direction = -1, Toggle = false},
        new { Target = "D", Cap = 4, Count = 0, Delay = "0.8s", Direction = -1, Toggle = false},
        new { Target = "L", Cap = 2, Count = 0, Delay = "0.2s", Direction = -1, Toggle = true},
        new { Target = "E", Cap = 1, Count = 0, Delay = "1.4s", Direction = -1, Toggle = true}
    };
}  

<div class="container">
    @foreach (var item in containers)
    {
        <div class="letter-container @(item.Toggle ? "active" : "inactive")"
             data-target="@item.Target"
             data-cap="@item.Cap"
             data-count="@item.Count"
             style="--d: @item.Delay; --r: @item.Direction;">

            <div class="upper @(item.Direction == 1 ? "active" : "")">
                <span class="letter"></span>
            </div>

            <div class="middle">
                <span class="letter">B</span>
            </div>

            <div class="lower @(item.Direction == -1 ? "active" : "")">
                <span class="letter"></span>
            </div>

        </div>
    }
</div>