@* Page Content *@
<div id="page-content" class="position-relative vh-100">
  @* Background *@
  <div id="background-container" class="position-absolute z-n1 w-100">
    <img id="background-static" src="@ViewData["Background"]" class="w-100" />
    @* <video autoplay="autoplay" muted="muted" loop="loop">
      <source src="~/assets/default/backgrounds/waves-background-animated.mp4" type="video/mp4">
    </video> *@
  </div>
  @* Floating Title *@
  <div class="container-fluid text-center align-items-center bg-transparent">
    <div class="row">
      <p class="fs-1 fw-bold floating-title">Sean Canning</p>
      <p class="fs-3 floating-title">Software Engineer</p>
    </div>
  </div>
  @* Quick Cards *@
  <div class="container-fluid h-25 px-5 align-middle justify-content-center">
    <div class="row justify-content-center h-100">
      @foreach (var card in quickCards)
      {
        status = "static";
        switch (status)
        {
          case "static":
            {
              <div class="col p-3 h-100">
                <div class="quick-card" style="--primary-colour: @card.Colour">
                  @switch (cardMedia)
                  {
                    case "image":
                      <img src="@ViewData[$"quick-card-{quickCardCount}"]" />
                      @* @ { 
                        Console.WriteLine(currentTheme); 
                        Console.WriteLine(quickCardCount); 
                      } *@
                      <span>@card.Title</span>
                      break;
                    case "video":
                      <video autoplay="autoplay" muted="muted" loop="loop">
                        <source src="~/assets/default/backgrounds/waves-background-animated.mp4" type="video/mp4">
                      </video>
                      <span>@card.Title</span>
                      break;
                  }
                </div>
              </div>
              break;
            }
          case "dynamic":
          default:
            {
              <div class="col p-4">
                <a asp-area="" asp-controller="@card.Controller" asp-action="Index" class="text-decoration-none">
                  <div class="card nav-card position-relative overflow-hidden h-100">
                    <video autoplay muted loop playsinline class="nav-card-video">
                      <source src="~/assets/default/backgrounds/room-sunset.mp4" type="video/mp4">
                    </video>
                    <div class="position-absolute top-0 start-0 w-100 h-100 d-flex justify-content-center align-items-center">
                      <h3 class="text-white fw-bold mb-0">
                        @card.Title
                      </h3>
                    </div>
                  </div>
                </a>
              </div>
              break;
            }
        }

        quickCardCount++;
      }
    </div>
  </div>
  @* Main Body *@
  <div class="container-fluid h-auto">
    <div class="row h-100 bg-white p-3">
      <div class="col-8 pe-4">
