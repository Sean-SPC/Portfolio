@{
  ViewData["Title"] = "Home Page";
}
<!-- Loading Content -->
<div id="spindash-loader-div">
  <div class="row">
    <div class="col-12 text-center">
      <img id="spindash-loader" class="nav-link" alt="sonic-loader"/>
    </div>
  </div>
  <div class="row">
    <div class="col-12 text-center">
      <span id="loading-text" class="display-2"></span>
    </div>
  </div>
</div>

<!-- Page Content -->
<div id="page-content" class="vh-100">
  <!-- Background -->
  <video autoplay="autoplay" muted="muted" loop="loop" class="vw-100 position-absolute z-n1">
    <source src="/src/images/waves-background-animated.mp4" type="video/mp4">
  </video>
  <!-- Floating Title -->
  <div class="container h-40 position-relative z-1 text-center align-items-center bg-transparent">
    <div class="row">
      <p class="fs-1 fw-bold text-white">Sean Canning</p>
      <p class="fs-3 text-white">Software Engineer</p>
    </div>
  </div>
  <!-- Nav Cards -->
  <div class="container-fluid h-75 text-center align-middle">
    <div class="row h-100">
      <div class="col">
        <div class="card h-100 nav-card">
          <img src="..." class="card-img" alt="...">
          <div class="card-img-overlay">
            <h3 class="card-title">Projects</h3>
          </div>
        </div>
      </div>
      <div class="col">
        <div class="card h-100 nav-card">
          <img src="..." class="card-img" alt="...">
          <div class="card-img-overlay">
            <h3 class="card-title">About</h3>
          </div>
        </div>
      </div>
      <div class="col">
        <div class="card h-100 nav-card">
          <img src="..." class="card-img" alt="...">
          <div class="card-img-overlay">
            <h3 class="card-title">Contact</h3>
          </div>
        </div>
      </div>
      <div class="col">
        <div class="card h-100 nav-card">
          <img src="..." class="card-img" alt="...">
          <div class="card-img-overlay">
            <h3 class="card-title">Another</h3>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<link rel="stylesheet" href="css/Home.css"/>
<script src="js/Home.js"/>