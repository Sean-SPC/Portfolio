@{
  ViewData["Title"] = "Home Page";
}

@{
    var navigationCards = new[]
    {
        new { Title = "Projects", Controller = "Projects" },
        new { Title = "About", Controller = "About" },
        new { Title = "Contact", Controller = "Contact" },
        new { Title = "Sandbox", Controller = "Sandbox" }
    };
}

