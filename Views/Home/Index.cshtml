@{
  ViewData["Title"] = "Home Page";
  @* var currentTheme = Configuration["Theme:Default"] ?? "infamous-good"; *@
  var currentTheme = ViewData["CurrentTheme"];
}

@if (ViewData["Primary-Text"] is not null)
{
    <style>
        :root {
            --primary-text: @ViewData["Primary-Text"];
        }
    </style>
}

@{
  string status = "static";
  string cardMedia = "image";
  int quickCardCount = 1;

  var quickCards = new[]
  {
      new { Title = "Projects", Card_Image="水", Controller = "Projects", Colour = "#0000FF" },
      new { Title = "About", Card_Image="風", Controller = "About", Colour = "#928c8cff" },
      new { Title = "Contact", Card_Image="石", Controller = "Contact", Colour = "#00FF00" },
      new { Title = "Sandbox", Card_Image="炎", Controller = "Sandbox", Colour = "#FF0000" }
  };
}

