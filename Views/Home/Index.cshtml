<!-- Page Content -->
<div id="page-content" class="vh-100">
  <!-- Background -->
  <video autoplay="autoplay" muted="muted" loop="loop" class="vh-100 position-absolute z-n1">
    <source id="background-video" src="/src/backgrounds/@(ViewBag.BackgroundVideo)" type="video/mp4">
  </video>
  @* <img src="~/assets/sonic/background-gif.gif" class="vh-100 position-absolute z-n1"/> *@
  <!-- Floating Title -->
  <div class="container-md h-40 text-center align-items-center bg-transparent">
    <div class="row">
      <p class="fs-1 fw-bold text-white">Sean Canning</p>
      <p class="fs-3 text-white">Software Engineer</p>
    </div>
  </div>
  <!-- Nav Cards -->
  <div class="container-fluid h-50 px-5 text-center align-middle">
    <div class="row h-100 gx-4 gy-4">
    @foreach (var card in navigationCards)
    {
        <div class="col p-3">
            <a asp-area=""
              asp-controller="@card.Controller"
              asp-action="Index"
              class="text-decoration-none">
                <div class="card nav-card position-relative overflow-hidden h-100">
                    <video autoplay muted loop playsinline class="nav-card-video">
                        <source src="/src/backgrounds/room-sunset.mp4" type="video/mp4">
                    </video>
                    <div class="position-absolute top-0 start-0 w-100 h-100 d-flex justify-content-center align-items-center">
                        <h3 class="text-white fw-bold mb-0">
                            @card.Title
                        </h3>
                    </div>
                </div>
            </a>
        </div>
    }
    </div>
  </div>
</div>
<link rel="stylesheet" href="css/Home.css"/>
@* <script src="js/Home.js"/> *@