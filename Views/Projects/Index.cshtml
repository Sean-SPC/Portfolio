@model IEnumerable<Portfolio.Models.Project>

@{
    ViewData["Title"] = "Projects";
}

<div class="container py-3">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h1 class="display-6 fw-bold mb-1">Projects</h1>
            <p class="text-muted mb-0">Browse, manage, and sync projects from GitHub.</p>
        </div>
        <div class="d-flex gap-2">
            <form asp-action="SyncProjects" method="post" class="d-inline">
                <button type="submit" class="btn btn-outline-success shadow-sm">
                    🔄 Sync from GitHub
                </button>
            </form>
            <a asp-action="Create" class="btn btn-primary shadow-sm">
                + Create New Project
            </a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center py-4 my-4">
            <p class="mb-3 fs-5">No projects found in the database.</p>
            <form asp-action="SyncProjects" method="post" class="d-inline me-2">
                <button type="submit" class="btn btn-success">Sync from GitHub now</button>
            </form>
            <a asp-action="Create" class="btn btn-outline-primary">Add manually</a>
        </div>
    }
    else
    {
        <!-- Card Grid View -->
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-5">
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="card-title fw-semibold text-primary mb-0">@item.Name</h5>
                                @if (!string.IsNullOrEmpty(item.Language))
                                {
                                    <span class="badge bg-dark">@item.Language</span>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(item.HTML_URL))
                            {
                                <p class="card-text text-muted small mt-2 mb-3">
                                    <a href="@item.HTML_URL" target="_blank" rel="noopener noreferrer" class="text-decoration-none text-truncate d-inline-block mw-100">
                                        🔗 @item.HTML_URL
                                    </a>
                                </p>
                            }
                            <div class="mt-auto pt-3 border-top d-flex gap-2">
                                <a asp-action="Details" asp-route-id="@item.ID" class="btn btn-sm btn-outline-primary flex-fill">Details</a>
                                <a asp-action="Edit" asp-route-id="@item.ID" class="btn btn-sm btn-outline-secondary">Edit</a>
                                <a asp-action="Delete" asp-route-id="@item.ID" class="btn btn-sm btn-outline-danger">Delete</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Table View -->
        <div class="card shadow-sm border">
            <div class="card-header bg-light py-3">
                <h5 class="mb-0 fw-semibold">All Projects (Table View)</h5>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>@Html.DisplayNameFor(model => model.Name)</th>
                            <th>@Html.DisplayNameFor(model => model.Language)</th>
                            <th>@Html.DisplayNameFor(model => model.HTML_URL)</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@item.Name</td>
                                <td>
                                    <span class="badge bg-secondary">@item.Language</span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.HTML_URL))
                                    {
                                        <a href="@item.HTML_URL" target="_blank" rel="noopener noreferrer" class="text-decoration-none">
                                            @item.HTML_URL
                                        </a>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@item.ID" class="btn btn-sm btn-link text-decoration-none">Details</a>
                                    <a asp-action="Edit" asp-route-id="@item.ID" class="btn btn-sm btn-link text-decoration-none">Edit</a>
                                    <a asp-action="Delete" asp-route-id="@item.ID" class="btn btn-sm btn-link text-danger text-decoration-none">Delete</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
