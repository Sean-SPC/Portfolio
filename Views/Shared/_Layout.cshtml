<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Portfolio</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Portfolio.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">HomePage</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <!-- PAGE NAVIGATION -->
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Projects" asp-action="Index">Projects</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Contact" asp-action="Index">Contact</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="About" asp-action="Index">About</a>
                        </li>
                    </ul>
                </div>
                <div>
                    <!-- SOCIAL LINKS -->
                    <div class="d-flex flex-row-reverse gx-5">
                        <div class="p-3">
                            <a class="nav-link text-dark" href="https://www.fiverr.com/sean_spc/buying?source=avatar_menu_profile">
                                <img class="nav-link img-icon" src="/src/images/fiverr.png" alt="fiverr"/>
                            </a>
                        </div>
                        <div class="p-3">
                            <a class="nav-link text-dark" href="https://profile.hackthebox.com/profile/019c81c0-4f22-7136-8f5d-5599b76993fd">
                                <img class="nav-link img-icon" src="/src/images/hackthebox.png" alt="HackTheBox"/>
                            </a>
                        </div>
                        <div class="p-3">
                            <a class="nav-link text-dark" href="https://tryhackme.com/p/SPCTHM">
                                <img class="nav-link img-icon" src="/src/images/tryhackme.png" alt="TryHackMe"/>
                            </a>
                        </div>
                        <div class="p-3">
                            <a class="nav-link text-dark" href="https://www.hackerrank.com/profile/seancanning">
                                <img class="nav-link img-icon" src="/src/images/hackerrank.png" alt="HackerRank"/>
                            </a>
                        </div>
                        <div class="p-3">
                            <a class="nav-link text-dark text-center" href="https://github.com/Sean-SPC">
                                <img class="nav-link img-icon" src="/src/images/github.png" alt="GitHub"/>
                            </a>
                        </div>
                        <div class="p-3 text-center">
                            <a class="nav-link text-dark text-center" href="https://linkedin.com/in/sean-canning-3a2896360">
                                <img class="nav-link img-icon" src="/src/images/linkedin.png" alt="LinkedIn"/>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <footer class="border-top footer text-muted">
        <div class="container-fluid">
            &copy; 2025 - Portfolio
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
